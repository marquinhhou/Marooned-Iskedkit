<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/row_bg_ge"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_outline_bg_ge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <TextView
            android:id="@+id/archived_row_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ge_accent"
            android:textStyle="bold"
            android:textSize="8sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <TextView
        android:id="@+id/archived_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ge_ink_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/archived_row_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/ge_ink_dim"
        android:textSize="10.5sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/archived_row_restore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="RESTORE"
            android:textColor="@color/ge_bg"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:background="@drawable/btn_bg_ge"
            android:backgroundTint="@color/ge_accent"
            android:foreground="@drawable/ripple_rounded_12dp_ge"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/archived_row_copy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/row_bg_ge"
            android:foreground="@drawable/ripple_rounded_14dp_ge"
            android:contentDescription="Copy"
            android:src="@drawable/ic_copy_ge" />

        <ImageView
            android:id="@+id/archived_row_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/row_bg_ge"
            android:foreground="@drawable/ripple_rounded_14dp_ge"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete_ge" />
    </LinearLayout>
</LinearLayout>

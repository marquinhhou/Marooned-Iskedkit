<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/row_group_header_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/chip_outline_bg_ge"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/row_group_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ge_ink"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/ge_ink_dim"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/row_group_chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_down_ge" />
    </LinearLayout>

</FrameLayout>

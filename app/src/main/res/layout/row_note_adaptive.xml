<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_note_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/row_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row_bg_adaptive"
        android:padding="8dp">

        <ImageView
            android:id="@+id/row_note_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:padding="1dp"
            android:src="@drawable/dot_dim_adaptive" />

        <LinearLayout
            android:id="@+id/row_note_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/row_note_urgent_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_outline_bg_adaptive"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="\u26A0 URGENT"
                    android:textColor="@color/adaptive_error"
                    android:textStyle="bold"
                    android:textSize="7.5sp"
                    android:letterSpacing="0.03"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/row_note_subject_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_outline_bg_adaptive"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp">

                    <TextView
                        android:id="@+id/row_note_subject_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/adaptive_accent"
                        android:textStyle="bold"
                        android:textSize="8sp"
                        android:letterSpacing="0.05"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/row_note_deadline_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/adaptive_ink_dim"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <TextView
                android:id="@+id/row_note_deadline_absolute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/adaptive_ink_dim"
                android:textSize="8.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/row_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/adaptive_ink"
                android:textStyle="bold"
                android:textSize="13.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/row_note_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/adaptive_ink_dim"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/row_note_archive"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:src="@drawable/ic_archive_adaptive" />

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary dialog button: quiet surface fill + hairline border, matching the
     Primary btn_bg radius (12dp) so stacked buttons share one silhouette. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/ge_surface" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="@color/ge_line" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Unchecked-note checkbox for Custom theme: an outline circle instead of a solid
     dot. Tinted to the dim ink tone at render time, it reads as "empty box" without
     the glaring pale blob a filled 20dp circle became over dark frosted rows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#00000000" />
    <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
</shape>

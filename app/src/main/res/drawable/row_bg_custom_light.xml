<?xml version="1.0" encoding="utf-8"?>
<!-- Custom-mode widget surface (light backdrop): milky glass fill plus a quiet dark
     hairline, the light-system counterpart of row_bg_custom_dark. See that file for
     why the colors are baked in rather than applied as a RemoteViews tint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#9EFFFFFF" />
    <stroke android:width="1dp" android:color="#57000000" />
    <corners android:radius="14dp" />
</shape>
